{% extends template('page-layout-main') %}
{% define data = {
    antelopes: _view.antelopes
} %}

{% block body %}
    <h1>Antelopes</h1>
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Name</th>
            <th>Color</th>
            <th>Location</th>
        </tr>
        </thead>
        {% for antelope in data.antelopes %}
            <tr>
                <td> {{ antelope.name }}</td>
                <td> {{ antelope.color }}</td>
                <td> {{ antelope.locationName }}</td>
            </tr>
        {% endfor %}
    </table>
{% endblock %}
