<?xml version="1.0"?>
<database xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="zed"
          xsi:noNamespaceSchemaLocation="http://static.spryker.com/schema-01.xsd"
          namespace="Orm\Zed\Book\Persistence"
          package="src.Orm.Zed.Book.Persistence">

    <table name="pyz_book" idMethod="native" allowPkInsert="true"
           phpName="PyzBook">

        <column name="id_book" required="true" type="INTEGER"
                primaryKey="true" autoIncrement="true"/>
        <column name="title" required="true" type="VARCHAR" size="255"/>
        <column name="author" required="true" type="VARCHAR" size="255"/>
        <column name="isbn" required="true" type="VARCHAR" size="255"/>
        <column name="published_date" required="true" type="DATE"/>
        <column name="price" required="true" type="DECIMAL"/>

        <unique name="pyz_book-title">
            <unique-column name="title"/>
        </unique>

        <id-method-parameter value="pyz_book_pk_seq"/>

    </table>
</database>
